# Hikyaku の設定（リポジトリ全体）
#
# ドキュメントの所在は document-guide.md が唯一の宣言先です。
# このファイルには振る舞いの設定だけを書きます。
#
# base_branch / [branch] / [pr] / [session] / [external] は、サイクルごとに
# {HIKYAKU_ROOT}/cycles/{NNN}-{slug}/.hikyaku.config で上書きできます。

hikyaku_root = ".hikyaku"

# サイクル作成時に create-cycle が尋ねるキー。答えはそのサイクルの
# .hikyaku.config に記録されます。下に書いた値は、尋ねるときの既定として
# 提示されます（profile と同じで、config は推奨、決めるのは作成時）。
# 指定できるキー: base_branch | branch.prefix | branch.separator | pr.title | session.title | external.target
ask = ["base_branch", "external.target"]

# サイクル作成時に提示する profile の既定値。
# 無条件には採用されず、create-cycle が必ず明示的な選択を求めます。
# profile = "standard"   # express | economy | standard | thorough

# PR のベースブランチ（未設定ならリポジトリのデフォルトブランチを自動検出）
# base_branch = "main"

# ブランチ名は {prefix}{separator}{cycle}{separator}{phase} で構成します。
# 着手状態の導出にブランチ名を解析するため、構造は固定です。
[branch]
# prefix = "hikyaku"
# separator = "/"        # 空文字は不可（解析できなくなるため）

# PR タイトルは表示専用なので自由に組み立てられます。
# 使える変数: {cycle} {cycle_id} {cycle_name} {phase} {build_id} {title}
[pr]
# title = "[hikyaku] {cycle}: {phase} {title}"

# セッション名。変数は [pr] と共通です。
# 空文字にするとセッション名を変更しません。
[session]
# title = "{cycle} {phase} {title}"

# security_review を推奨する判定基準。設定すると既定値を丸ごと置き換えます。
# 機微情報の定義はプロダクトごとに異なるため、自然言語で記述します。
[review.security]
# triggers = """
# - 個人情報・秘密情報を扱う
# - 認証・認可
# - 決済
# """

# サイクルごとに GitHub issue を1つ起票し、CLOSE の PR で閉じます。マスターは常にファイル側です。
[external]
target = "github"        # none | github
github_repo = "tak-solder/hikyaku"

# メインセッションのコンテキストの上限です。予測ピークが見積もりの上限（limit × estimate_ratio）を
# 超えたら分割を検討し、limit × merge_ratio 未満なら統合を検討します。
# builder の区切り（G8・実装開始前・レビュー前）では、完了時点の見込みを limit と比べます。
[context]
# limit = "600k"
# estimate_ratio = "90%"
# merge_ratio = "60%"

# conductor の子セッションに許可するツール（既定に追加される）
[conductor]
allowed_tools = ["Bash(npm test:*)", "Bash(npm run typecheck:*)", "Bash(npx tsc:*)", "Bash(node --test:*)", "Bash(node scripts/hikyaku.mts:*)"]
